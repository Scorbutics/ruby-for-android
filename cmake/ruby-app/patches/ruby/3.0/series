# Ruby 3.0's configure reads EXTSTATIC (--with-static-linked-ext) after the
# darwin block that picks the extension link flags, so static macOS/iOS builds
# get -bundle_loader '$(BUILTRUBY)' and linking ruby fails with
# "ld: -bundle_loader missing <path>". 3.1+ parse the option first. Only the
# generated configure is patched (no darwin change elsewhere, inert on Linux/Android).
fix-darwin-static-ext-bundle-loader.patch

# Ruby 3.0's rbinstall.rb installs default/bundled gems into Gem.default_dir
# of the Ruby running it: on a cross build that is the host Ruby, whose
# operating_system.rb may redirect it (Debian /var/lib/gems, Homebrew
# /opt/homebrew), so make install fails. Use the target RbConfig instead.
fix-rbinstall-default-gem-dir.patch

# Pokemon Studio games ship bytecode compiled by the Ruby of the OS that built
# them: Studio's Windows Ruby is 32-bit (i386-mingw32), so its bytecode names
# another platform and stores 4-byte words. Accept it (and the 64-bit Linux/macOS
# dumps) and widen its words while loading. Also detects the bytecode of Ruby
# 3.0.0-3.0.2, whose iseq bodies lack outer_variables (same format version).
load-foreign-bytecode.patch

# Ruby 3.2's internal thread events (rb_internal_thread_add_event_hook, same
# API and firing points): LiteRGSS3's raylib backend hands its single GL
# context to the thread holding the GVL with them, so it runs on Ruby 3.0.
# The implementation is sources/ruby/3.0/thread_event_hooks.c (+ headers);
# this patch fires the events in thread_pthread.c and builds the object.
internal-thread-event-hooks.patch

# Xcode 16.3+'s clang rejects bigdecimal's ENTER: a C23 [[maybe_unused]]
# after the array declarator vStack[n] applies to its type ("'maybe_unused'
# attribute cannot be applied to types"). Put it before the declaration,
# as the bigdecimal of Ruby 3.2 does.
fix-bigdecimal-maybe-unused.patch
