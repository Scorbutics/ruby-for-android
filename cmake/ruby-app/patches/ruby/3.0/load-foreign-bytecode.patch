+/*
+ * Bytecode dumped by a 32-bit Ruby (Pokemon Studio's Windows build is
+ * i386-mingw32) has the same format as the native one except where it stores
+ * machine words: VALUE, ID and long fields are 4 bytes, and its special
+ * constants have no flonum encoding. These helpers widen them.
+ */
+
+/* A small value holding a signed word, such as a backward jump offset. */
+static VALUE
+ibf_load_small_svalue(const struct ibf_load *load, ibf_offset_t *offset)
+{
+    VALUE x = ibf_load_small_value(load, offset);
+    if (load->foreign32) {
+        x = (VALUE)(SIGNED_VALUE)(int32_t)(uint32_t)x;
+    }
+    return x;
+}
+
+/* A special constant (Fixnum, true, false, nil or undef) of a 32-bit Ruby. */
+static VALUE
+ibf_load_foreign32_special_const(VALUE x)
+{
+    const uint32_t v = (uint32_t)x;
+
+    if (v & 1) {
+        return (VALUE)(SIGNED_VALUE)(int32_t)v; /* Fixnum: 2n+1 */
+    }
+    switch (v) {
+      case 0x00: return Qfalse;
+      case 0x02: return Qtrue;
+      case 0x04: return Qnil;
+      case 0x06: return Qundef;
+    }
+    rb_raise(rb_eRuntimeError, "unsupported 32-bit special constant: %#x", v);
+}
+
+static VALUE
+ibf_load_special_const(const struct ibf_load *load, VALUE x)
+{
+    return load->foreign32 ? ibf_load_foreign32_special_const(x) : x;
+}
+
+/* Size and alignment of a VALUE, ID or long of the dumping Ruby. */
+static size_t
+ibf_load_word_size(const struct ibf_load *load)
+{
+    return load->foreign32 ? sizeof(uint32_t) : sizeof(VALUE);
+}
+
+static const char *
+ibf_load_check_range(const struct ibf_load *load, ibf_offset_t offset, size_t size)
+{
+    if (offset > load->current_buffer->size || size > load->current_buffer->size - offset) {
+        rb_raise(rb_eIndexError, "object offset out of range: %u", offset);
+    }
+    return load->current_buffer->buff + offset;
+}
+
+/* The index-th word of the table at offset, zero-extended. */
+static VALUE
+ibf_load_word(const struct ibf_load *load, ibf_offset_t offset, size_t index)
+{
+    const size_t word_size = ibf_load_word_size(load);
+    const char *ptr = ibf_load_check_range(load, offset + (ibf_offset_t)(index * word_size), word_size);
+
+    if (load->foreign32) {
+        uint32_t v;
+        memcpy(&v, ptr, sizeof(v));
+        return (VALUE)v;
+    }
+    else {
+        VALUE v;
+        memcpy(&v, ptr, sizeof(v));
+        return v;
+    }
+}
+
+/* The index-th word of the table at offset, sign-extended. */
+static long
+ibf_load_sword(const struct ibf_load *load, ibf_offset_t offset, size_t index)
+{
+    VALUE v = ibf_load_word(load, offset, index);
+    return load->foreign32 ? (long)(int32_t)(uint32_t)v : (long)v;
+}
+
+/* A table of n words (VALUE or ID), copied into native words. */
+static VALUE *
+ibf_load_word_table(const struct ibf_load *load, ibf_offset_t offset, size_t n)
+{
+    VALUE *table = ALLOC_N(VALUE, n);
+    size_t i;
+
+    for (i = 0; i < n; i++) {
+        table[i] = ibf_load_word(load, offset, i);
+    }
+    return table;
+}
