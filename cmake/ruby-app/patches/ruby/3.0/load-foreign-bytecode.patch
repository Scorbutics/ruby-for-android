+/*
+ * Pokemon Studio ships games as bytecode compiled by the Ruby of the OS it
+ * runs on, so the bytecode of a game names that platform. Accept the
+ * platforms whose dumps this loader can read:
+ * - 64-bit little-endian Linux and macOS (LP64, flonum): the native layout.
+ * - 32-bit x86 Windows and Linux (Studio's Windows Ruby is i386-mingw32):
+ *   foreign32 mode widens its words, see ibf_load_small_svalue().
+ *   _Alignof(double) is 8 on the Windows i386 ABI and 4 on the System V one.
+ * x64-mingw is refused: its long (Range, bignum and Data fields) is 32-bit.
+ */
+static int
+ibf_platform_prefix_p(const char *platform, const char *prefix)
+{
+    return strncmp(platform, prefix, strlen(prefix)) == 0;
+}
+
+static void
+ibf_load_check_platform(struct ibf_load *load, const char *platform)
+{
+    if (strcmp(platform, RUBY_PLATFORM) == 0) {
+        return;
+    }
+#if SIZEOF_VALUE == 8 && SIZEOF_LONG == 8 && USE_FLONUM && !defined(WORDS_BIGENDIAN)
+    if (ibf_platform_prefix_p(platform, "x86_64-linux") ||
+        ibf_platform_prefix_p(platform, "aarch64-linux") ||
+        ibf_platform_prefix_p(platform, "x86_64-darwin") ||
+        ibf_platform_prefix_p(platform, "arm64-darwin")) {
+        return;
+    }
+    if (platform[0] == 'i' && platform[1] >= '3' && platform[1] <= '6' &&
+        ibf_platform_prefix_p(platform + 2, "86-")) {
+        const char *os = platform + 5;
+        if (ibf_platform_prefix_p(os, "mingw") || ibf_platform_prefix_p(os, "mswin")) {
+            load->foreign32 = TRUE;
+            load->foreign32_double_align = 8;
+            return;
+        }
+        if (ibf_platform_prefix_p(os, "linux")) {
+            load->foreign32 = TRUE;
+            load->foreign32_double_align = 4;
+            return;
+        }
+    }
+#endif
+    rb_raise(rb_eRuntimeError, "unmatched platform");
+}
+
+/*
+ * Ruby 3.0.3 added outer_variables_offset to the iseq body without changing
+ * the format version, so 3.0.0-3.0.2 bodies have one field less. The last
+ * dumped body ends right before the aligned iseq list: parse it with each
+ * field count and keep the one that ends on the zero padding before the list.
+ */
+#define IBF_ISEQ_BODY_FIELDS 40
+
+static int
+ibf_load_body_ends_on_iseq_list(const struct ibf_load *load, ibf_offset_t pos, int fields)
+{
+    const unsigned char *buff = (const unsigned char *)load->global_buffer.buff;
+    const ibf_offset_t list = load->header->iseq_list_offset;
+    int i;
+
+    for (i = 0; i < fields; i++) {
+        if (pos >= list) return FALSE;
+        const unsigned char c = buff[pos];
+        pos += c & 1 ? 1 : c == 0 ? 9 : ntz_int32(c) + 1;
+    }
+    if (pos > list || list - pos >= sizeof(ibf_offset_t)) return FALSE;
+    for (; pos < list; pos++) {
+        if (buff[pos] != 0) return FALSE;
+    }
+    return TRUE;
+}
+
+static void
+ibf_load_detect_body_layout(struct ibf_load *load)
+{
+    const unsigned int size = load->header->iseq_list_size;
+    const ibf_offset_t list_offset = load->header->iseq_list_offset;
+    ibf_offset_t last = 0;
+    unsigned int i;
+
+    if (size == 0 || list_offset > load->global_buffer.size ||
+        size > (load->global_buffer.size - list_offset) / sizeof(ibf_offset_t)) {
+        return;
+    }
+    for (i = 0; i < size; i++) {
+        ibf_offset_t offset;
+        memcpy(&offset, load->global_buffer.buff + list_offset + i * sizeof(ibf_offset_t), sizeof(offset));
+        if (offset > last) last = offset;
+    }
+    if (last >= list_offset || ibf_load_body_ends_on_iseq_list(load, last, IBF_ISEQ_BODY_FIELDS)) {
+        return;
+    }
+    if (ibf_load_body_ends_on_iseq_list(load, last, IBF_ISEQ_BODY_FIELDS - 1)) {
+        load->no_outer_variables = TRUE;
+    }
+}
