# rbinstall.rb installs default/bundled gems into Gem.default_dir of the Ruby
# running it: on a cross build that is the host Ruby, whose operating_system.rb
# may redirect it (Homebrew /opt/homebrew on the macOS runner, Debian
# /var/lib/gems), so the gems end up outside the packaged lib/ruby/gems.
# Use the target RbConfig instead.
fix-rbinstall-default-gem-dir.patch
